# ========================================
# Frontend (React / Vite) .gitignore
# ========================================

# Dependencies (MUST NOT push to GitHub - very heavy)
node_modules/
.pnp
.pnp.js

# Production / Build output
dist/
dist-ssr/
build/

# Environment files & Secrets (never expose secrets/API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary / Local testing files
powershell.cmd
test.css
